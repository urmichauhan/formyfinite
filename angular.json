{
  "version": 1,
  "projects": {
    "formyfinite": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "web",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "web/main.ts",
            "index": "web/index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist/formyfinite",
            "styles": [
              "web/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "formyfinite:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
