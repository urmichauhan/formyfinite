  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "ng build",
    "start": "node api/start.js",
    "dev": "concurrently \"node --watch api/start.js\" \"ng serve --proxy-config proxy.json\"",
