    "@angular/router": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "express": "^5.2.1",
    "mongoose": "^8.24.0",
    "helmet": "^8.3.0",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.7.0",
    "zod": "^4.1.0",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "typescript": "~5.9.3",
    "concurrently": "^9.2.0",
